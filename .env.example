# Copy to .env and fill in. Never commit .env. Never paste keys in chat or issues.
# Voice for urgent messages. Without a key, urgent messages are logged with no audio.
ELEVENLABS_API_KEY=
# Optional: the id of the voice to use, and the model. Leave empty for the defaults.
ELEVENLABS_VOICE=
ELEVENLABS_MODEL=
# Optional: the decision model. Without a key, the fixed rules decide.
GEMINI_API_KEY=
GEMINI_MODEL=
# Not used yet.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# The number on the bag of your Vexo band (1 to 999). Example only.
VEXO_BAND=

# Hub settings. Set these in the terminal, not here: the hub reads them from the environment only.
#   EPSILON_HOST=0.0.0.0   let another laptop (Zach's) reach the hub. Default 127.0.0.1.
#   EPSILON_PORT=8787
#   EPSILON_TOKEN=...      a shared word Zach sends in the X-Epsilon-Token header
#   EPSILON_IMESSAGE=1     send texts through imessage/ (needs imessage/.env filled in)
